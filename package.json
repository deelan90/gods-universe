{
  "name": "gods-universe",
  "private": true,
  "version": "1.1.0",
  "description": "God's Universe — Interactive 3D Map & Live Telemetry Observatory of the Observable Universe",
  "type": "module",
  "scripts": {
    "sync-data": "node server/syncData.mjs && node server/syncLive.mjs",
    "server": "node server/index.mjs",
    "client": "vite",
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"node server/index.mjs\" \"vite\"",
    "build": "tsc -b && vite build",
    "preview": "node server/index.mjs --serve-static",
    "sync-live": "node server/syncLive.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "satellite.js": "^6.0.1",
    "three": "^0.176.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.7",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
